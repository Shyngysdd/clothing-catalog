generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String        @id @default(cuid())
  sku           String        @unique
  name          String
  brand         String        @default("AKSHYN")
  category      String
  department    String        @default("unisex")
  price         Int
  originalPrice Int?
  description   String?
  composition   String?
  care          String[]
  fit           String?
  imageColor    String
  imageUrl      String?
  galleryTones  String[]
  galleryUrls   String[]      @default([])
  colorGroup    String?
  color         String?
  colorSwatch   String?
  sizes         ProductSize[]
  lookItems     LookItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ProductSize {
  id        String  @id @default(cuid())
  size      String
  inStock   Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, size])
}

model Look {
  id          String     @id @default(cuid())
  title       String
  description String?
  photoTones  String[]
  photoUrls   String[]     @default([])
  items       LookItem[]
  favorites   LookFavorite[]
  createdAt   DateTime   @default(now())
}

model LookItem {
  id        String  @id @default(cuid())
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  lookId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
}

model Banner {
  id        String   @id @default(cuid())
  slot      String   @unique
  title     String
  subtitle  String?
  linkUrl   String
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

model HomeSection {
  id            String   @id @default(cuid())
  title         String
  type          String
  categoryValue String?
  productIds    String[]
  position      Int      @default(0)
  isActive      Boolean  @default(true)
}

model Customer {
  id           String     @id @default(cuid())
  email        String     @unique
  emailVerified Boolean    @default(false)
  verificationToken String? @unique
  verificationTokenExpiry DateTime?
  verificationEmailSentAt DateTime?
  passwordResetToken String? @unique
  passwordResetTokenExpiry DateTime?
  passwordResetEmailSentAt DateTime?
  passwordHash String
  name         String
  phone        String?
  orders       Order[]
  favorites    Favorite[]
  lookFavorites LookFavorite[]
  addresses    CustomerAddress[]
  createdAt    DateTime   @default(now())
}

model LookFavorite {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  look       Look     @relation(fields: [lookId], references: [id], onDelete: Cascade)
  lookId     String
  createdAt  DateTime @default(now())

  @@unique([customerId, lookId])
  @@index([lookId])
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  label       String?
  city        String
  addressLine String
  apartment   String?
  comment     String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId, isDefault])
}

model Order {
  id          String      @id @default(cuid())
  customer    Customer    @relation(fields: [customerId], references: [id])
  customerId  String
  items       OrderItem[]
  totalPrice  Int
  fulfillment String
  branchName  String?
  address     String?
  status      String      @default("new")
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String
  name      String
  size      String
  price     Int
  quantity  Int
}

model Favorite {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  productId  String
  selectedSize String?
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model Subscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())
}
