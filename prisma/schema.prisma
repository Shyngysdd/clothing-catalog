generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String        @id @default(cuid())
  sku           String        @unique
  name          String
  category      String
  price         Int
  originalPrice Int?
  description   String?
  composition   String?
  care          String[]
  fit           String?
  imageColor    String
  galleryTones  String[]
  sizes         ProductSize[]
  lookItems     LookItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ProductSize {
  id        String  @id @default(cuid())
  size      String
  inStock   Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, size])
}

model Look {
  id          String     @id @default(cuid())
  title       String
  description String?
  photoTones  String[]
  items       LookItem[]
  createdAt   DateTime   @default(now())
}

model LookItem {
  id        String  @id @default(cuid())
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  lookId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
}
